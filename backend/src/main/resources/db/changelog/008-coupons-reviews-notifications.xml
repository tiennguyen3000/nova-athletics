<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="008-01" author="nova">
    <createTable tableName="coupons"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="code" type="VARCHAR(64)"><constraints nullable="false" unique="true"/></column><column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column><column name="description" type="TEXT"/><column name="discount_type" type="VARCHAR(32)"><constraints nullable="false"/></column><column name="discount_value" type="NUMERIC(12,2)"><constraints nullable="false"/></column><column name="min_order_amount" type="NUMERIC(12,2)"/><column name="max_discount_amount" type="NUMERIC(12,2)"/><column name="usage_limit" type="INT"/><column name="usage_count" type="INT" defaultValueNumeric="0"/><column name="per_customer_limit" type="INT"/><column name="starts_at" type="TIMESTAMPTZ"/><column name="ends_at" type="TIMESTAMPTZ"/><column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="coupon_usages"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="coupon_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_cu_coupon" references="coupons(id)"/></column><column name="customer_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_cu_cust" references="customers(id)"/></column><column name="order_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_cu_ord" references="orders(id)"/></column><column name="discount_applied" type="NUMERIC(12,2)"><constraints nullable="false"/></column><column name="used_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <addUniqueConstraint tableName="coupon_usages" columnNames="coupon_id, order_id" constraintName="uq_cu_order"/>
    <createTable tableName="reviews"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="product_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_rev_prod" references="products(id)"/></column><column name="customer_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_rev_cust" references="customers(id)"/></column><column name="order_id" type="BIGINT"><constraints foreignKeyName="fk_rev_ord" references="orders(id)"/></column><column name="rating" type="SMALLINT"><constraints nullable="false"/></column><column name="title" type="VARCHAR(255)"/><column name="content" type="TEXT"/><column name="status" type="VARCHAR(32)" defaultValue="PENDING"/><column name="is_verified_purchase" type="BOOLEAN" defaultValueBoolean="false"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="notifications"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="user_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_notif_user" references="users(id)"/></column><column name="type" type="VARCHAR(64)"><constraints nullable="false"/></column><column name="title" type="VARCHAR(255)"><constraints nullable="false"/></column><column name="body" type="TEXT"/><column name="data" type="TEXT"/><column name="is_read" type="BOOLEAN" defaultValueBoolean="false"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
  </changeSet>
</databaseChangeLog>
