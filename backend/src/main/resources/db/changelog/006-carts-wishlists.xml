<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="006-01" author="nova">
    <createTable tableName="carts"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="customer_id" type="BIGINT"><constraints foreignKeyName="fk_cart_cust" references="customers(id)"/></column><column name="guest_id" type="VARCHAR(64)"/><column name="status" type="VARCHAR(32)" defaultValue="ACTIVE"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createIndex tableName="carts" indexName="idx_carts_customer"><column name="customer_id"/></createIndex>
    <createTable tableName="cart_items"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="cart_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ci_cart" references="carts(id)"/></column><column name="variant_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ci_var" references="product_variants(id)"/></column><column name="quantity" type="INT"><constraints nullable="false"/></column><column name="added_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <addUniqueConstraint tableName="cart_items" columnNames="cart_id, variant_id" constraintName="uq_cart_variant"/>
    <createTable tableName="wishlists"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="customer_id" type="BIGINT"><constraints nullable="false" unique="true" foreignKeyName="fk_wl_cust" references="customers(id)"/></column><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="wishlist_items"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="wishlist_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_wli_wl" references="wishlists(id)"/></column><column name="product_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_wli_prod" references="products(id)"/></column><column name="variant_id" type="BIGINT"><constraints foreignKeyName="fk_wli_var" references="product_variants(id)"/></column><column name="added_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <addUniqueConstraint tableName="wishlist_items" columnNames="wishlist_id, product_id" constraintName="uq_wl_product"/>
    <createTable tableName="recently_viewed"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="customer_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_rv_cust" references="customers(id)"/></column><column name="product_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_rv_prod" references="products(id)"/></column><column name="viewed_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <addUniqueConstraint tableName="recently_viewed" columnNames="customer_id, product_id" constraintName="uq_rv"/>
  </changeSet>
</databaseChangeLog>
