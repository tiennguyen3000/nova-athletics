<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="009-01" author="nova">
    <createTable tableName="media"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="idem_key" type="VARCHAR(512)"><constraints nullable="false" unique="true"/></column><column name="url" type="VARCHAR(512)"><constraints nullable="false"/></column><column name="original_name" type="VARCHAR(255)"/><column name="mime_type" type="VARCHAR(100)"><constraints nullable="false"/></column><column name="size_bytes" type="BIGINT"><constraints nullable="false"/></column><column name="uploaded_by" type="BIGINT"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="audit_logs"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="user_id" type="BIGINT"/><column name="action" type="VARCHAR(64)"><constraints nullable="false"/></column><column name="entity_type" type="VARCHAR(64)"><constraints nullable="false"/></column><column name="entity_id" type="VARCHAR(64)"/><column name="old_value" type="TEXT"/><column name="new_value" type="TEXT"/><column name="ip_address" type="VARCHAR(45)"/><column name="user_agent" type="VARCHAR(255)"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="store_settings"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="idem_key" type="VARCHAR(100)"><constraints nullable="false" unique="true"/></column><column name="value" type="TEXT"><constraints nullable="false"/></column><column name="updated_by" type="BIGINT"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
  </changeSet>
</databaseChangeLog>
