<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="005-01" author="nova">
    <createTable tableName="warehouses"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="code" type="VARCHAR(32)"><constraints nullable="false" unique="true"/></column><column name="name" type="VARCHAR(255)"><constraints nullable="false"/></column><column name="address" type="VARCHAR(512)"/><column name="city" type="VARCHAR(100)"/><column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/><column name="deleted_at" type="TIMESTAMPTZ"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="warehouse_inventory"><column name="variant_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_wi_var" references="product_variants(id)"/></column><column name="warehouse_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_wi_wh" references="warehouses(id)"/></column><column name="quantity_on_hand" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column><column name="quantity_reserved" type="INT" defaultValueNumeric="0"><constraints nullable="false"/></column><column name="version" type="INT" defaultValueNumeric="0"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <addPrimaryKey tableName="warehouse_inventory" columnNames="variant_id, warehouse_id"/>
    <createTable tableName="inventory_transactions"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="variant_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_it_var" references="product_variants(id)"/></column><column name="warehouse_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_it_wh" references="warehouses(id)"/></column><column name="type" type="VARCHAR(32)"><constraints nullable="false"/></column><column name="quantity" type="INT"><constraints nullable="false"/></column><column name="reference_type" type="VARCHAR(32)"/><column name="reference_id" type="BIGINT"/><column name="note" type="VARCHAR(512)"/><column name="created_by" type="BIGINT"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="inventory_reservations"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="variant_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ir_var" references="product_variants(id)"/></column><column name="warehouse_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ir_wh" references="warehouses(id)"/></column><column name="order_id" type="BIGINT"/><column name="cart_id" type="BIGINT"/><column name="quantity" type="INT"><constraints nullable="false"/></column><column name="status" type="VARCHAR(32)" defaultValue="ACTIVE"/><column name="expires_at" type="TIMESTAMPTZ"><constraints nullable="false"/></column><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="inventory_transfers"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="transfer_number" type="VARCHAR(32)"><constraints nullable="false" unique="true"/></column><column name="from_warehouse_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_tr_from" references="warehouses(id)"/></column><column name="to_warehouse_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_tr_to" references="warehouses(id)"/></column><column name="status" type="VARCHAR(32)" defaultValue="PENDING"/><column name="created_by" type="BIGINT"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="inventory_transfer_items"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="transfer_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ti_tr" references="inventory_transfers(id)"/></column><column name="variant_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ti_var" references="product_variants(id)"/></column><column name="quantity" type="INT"><constraints nullable="false"/></column><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
  </changeSet>
</databaseChangeLog>
