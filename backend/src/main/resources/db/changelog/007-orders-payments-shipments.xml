<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="007-01" author="nova">
    <createTable tableName="orders">
      <column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column>
      <column name="order_number" type="VARCHAR(32)"><constraints nullable="false" unique="true"/></column>
      <column name="customer_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ord_cust" references="customers(id)"/></column>
      <column name="status" type="VARCHAR(32)" defaultValue="PENDING"/><column name="subtotal" type="NUMERIC(12,2)"><constraints nullable="false"/></column>
      <column name="discount_total" type="NUMERIC(12,2)" defaultValueNumeric="0"/><column name="shipping_fee" type="NUMERIC(12,2)" defaultValueNumeric="0"/>
      <column name="tax_total" type="NUMERIC(12,2)" defaultValueNumeric="0"/><column name="grand_total" type="NUMERIC(12,2)"><constraints nullable="false"/></column>
      <column name="currency" type="VARCHAR(3)" defaultValue="VND"/><column name="coupon_code" type="VARCHAR(64)"/>
      <column name="shipping_address" type="TEXT"/><column name="billing_address" type="TEXT"/>
      <column name="notes" type="VARCHAR(512)"/><column name="cancelled_reason" type="VARCHAR(512)"/>
      <column name="version" type="INT" defaultValueNumeric="0"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/>
    </createTable>
    <createTable tableName="order_items"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="order_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_oi_ord" references="orders(id)"/></column><column name="product_id" type="BIGINT"><constraints nullable="false"/></column><column name="variant_id" type="BIGINT"><constraints nullable="false"/></column><column name="product_name" type="VARCHAR(255)"><constraints nullable="false"/></column><column name="sku" type="VARCHAR(64)"><constraints nullable="false"/></column><column name="variant_label" type="VARCHAR(255)"/><column name="image_url" type="VARCHAR(512)"/><column name="unit_price" type="NUMERIC(12,2)"><constraints nullable="false"/></column><column name="quantity" type="INT"><constraints nullable="false"/></column><column name="line_total" type="NUMERIC(12,2)"><constraints nullable="false"/></column><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="payments"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="order_id" type="BIGINT"><constraints nullable="false" unique="true" foreignKeyName="fk_pay_ord" references="orders(id)"/></column><column name="payment_number" type="VARCHAR(32)"><constraints nullable="false" unique="true"/></column><column name="provider" type="VARCHAR(32)" defaultValue="MOCK"/><column name="method" type="VARCHAR(32)"/><column name="status" type="VARCHAR(32)" defaultValue="PENDING"/><column name="amount" type="NUMERIC(12,2)"><constraints nullable="false"/></column><column name="currency" type="VARCHAR(3)" defaultValue="VND"/><column name="idempotency_key" type="VARCHAR(64)"/><column name="provider_ref" type="VARCHAR(255)"/><column name="paid_at" type="TIMESTAMPTZ"/><column name="failed_reason" type="VARCHAR(512)"/><column name="version" type="INT" defaultValueNumeric="0"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
    <createTable tableName="shipments"><column name="id" type="BIGSERIAL" autoIncrement="true"><constraints primaryKey="true"/></column><column name="order_id" type="BIGINT"><constraints nullable="false" foreignKeyName="fk_ship_ord" references="orders(id)"/></column><column name="warehouse_id" type="BIGINT"><constraints foreignKeyName="fk_ship_wh" references="warehouses(id)"/></column><column name="carrier" type="VARCHAR(64)"/><column name="tracking_number" type="VARCHAR(64)"/><column name="status" type="VARCHAR(32)" defaultValue="PENDING"/><column name="shipped_at" type="TIMESTAMPTZ"/><column name="delivered_at" type="TIMESTAMPTZ"/><column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/><column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="now()"/></createTable>
  </changeSet>
</databaseChangeLog>
